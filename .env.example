# Copy to .env.local and fill in. Never put real keys in this file — it is committed.

# ── Supabase (cloud mode). Leave blank for demo mode (browser-only data, no sign-in). ──
# Apply supabase/migrations/002_workspace_model.sql to the project before enabling. Migrations 003
# (automation), 004 (agent verification, identity, audit, score overrides), 005 (contacts and consent)
# and 006 (messaging) are optional: without them the app shows a "database update required" notice
# where the feature would be. See RUNBOOK §7–8.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (sb_publishable_…) or legacy anon key. Public by design; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Server-side integration keys. Never prefix these with NEXT_PUBLIC_. ──
# Google Places API (New). Restrict the key to "Places API (New)" and, in production, to your server's IPs.
GOOGLE_PLACES_API_KEY=
# Brave Search API (optional, paid) for website verification searches. Automated verification also
# needs a Brave Search budget in Automation Center → Controls; at most 4 queries per prospect.
BRAVE_SEARCH_API_KEY=
# Anthropic API (optional) for AI-assisted opportunity reports.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ── Estimated cost per call in USD, for usage tracking only. Check current Google/Brave pricing. ──
PLACES_COST_PER_SEARCH_USD=0.035
PLACES_COST_PER_DETAILS_USD=0.02
BRAVE_COST_PER_SEARCH_USD=0.005

# ── Daily quotas per workspace (0 disables the feature). ──
DAILY_DISCOVERY_QUOTA=50
DAILY_AI_REPORT_QUOTA=20
# One-sentence AI personal notes for message drafts (Outreach Drafting agent). Typically ~$0.01–0.03 each
# with claude-opus-5-5; the budget check reserves up to ~$0.10 (20k input + 1k output tokens).
DAILY_AI_NOTE_QUOTA=40
# AI readings of received messages (Response Classification agent, "Read with AI"). Off unless a person asks.
# Typically ~$0.005–0.01 each with claude-opus-5-5; the budget check reserves the worst case, ~$0.08 (16k input +
# 600 output tokens: replies are cut to 12,000 bytes, so no reply can cost more).
# Replies arriving by webhook are read by the free deterministic rules only.
DAILY_AI_CLASSIFY_QUOTA=100
# An automated verification uses up to ~8 website checks (DNS probes + homepage checks) and 4 searches.
DAILY_WEBSITE_CHECK_QUOTA=300
DAILY_WEB_SEARCH_QUOTA=100
# Mail-server (MX) lookups by the Contact Validation agent: DNS only, free. Mailboxes are never probed.
DAILY_MX_LOOKUP_QUOTA=300

# Allow server tools (discovery, website checks, AI) without sign-in on a private deployment.
# Always on in `next dev`. Keep false on any public deployment without Supabase.
DEMO_SERVER_TOOLS=false
# Test only: replace web search, DNS and website fetches with a labelled simulated world (no network,
# no cost). Used by the Playwright suite. Ignored whenever Supabase is configured. Leave false.
SIMULATE_EXTERNAL_TOOLS=false

# ── Scheduled automation worker (optional, cloud mode, migration 003). Server-only. ──
# Without these, queued research jobs run while a member keeps the Automation Center open.
# CRON_SECRET: a long random string (e.g. `openssl rand -hex 32`); the scheduler sends it as a Bearer token.
CRON_SECRET=
# Service-role key: bypasses row-level security. Read only by the server (the worker, webhooks,
# unsubscribe links and the worker-only writes of a message dispatch); every query is scoped to one
# organization. Never prefix with NEXT_PUBLIC_, never paste it into browser code.
SUPABASE_SERVICE_ROLE_KEY=

# ── Messaging (phase 7, cloud mode, migration 006). Server-only. SANDBOX ONLY in this version. ──
# Messages to businesses are blocked whatever is set here. The server sends only to the agency's own
# test recipients below, and only after the eligibility gateway passes. Leave everything blank until
# a sending domain and a WhatsApp Business Account are verified (RUNBOOK §11).
# Comma-separated addresses / numbers OWNED BY THE AGENCY (at most 10). Never a prospect's details.
MESSAGING_TEST_RECIPIENTS=
# The workspace (organization ID) that receives inbound replies. Single-workspace deployments only.
MESSAGING_ORGANIZATION_ID=
# At least 32 random characters (e.g. `openssl rand -hex 32`); signs per-message unsubscribe links.
MESSAGING_UNSUBSCRIBE_SECRET=
# Public https address of this app, for unsubscribe links and webhook URLs (no trailing slash).
APP_URL=
# Email through Resend (https://resend.com). Use a dedicated subdomain with SPF, DKIM and DMARC.
RESEND_API_KEY=
# "Agency name <hello@outreach.yourdomain.com>" on the verified sending domain.
MESSAGING_EMAIL_FROM=
# Optional: where replies go (a mailbox the team reads). Also used for the mailto unsubscribe header.
MESSAGING_EMAIL_REPLY_TO=
# Signing secret of the Resend webhook (whsec_…). Without it, bounces and complaints are not tracked.
RESEND_WEBHOOK_SECRET=
# WhatsApp Business Platform, Cloud API (official API only). From Meta's WhatsApp Manager / app dashboard.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# App secret (verifies X-Hub-Signature-256 on webhooks) and your own verify token for the callback URL.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Graph API version, e.g. v24.0 (default).
WHATSAPP_GRAPH_VERSION=

# ── Monitoring (optional, phase 10) ────────────────────────────────────────────────────────────────
# HTTPS webhook (team chat, alerting service) that receives each server error event, redacted: route,
# error name and digest, never message text or personal data. Leave empty to log to the host only.
ERROR_REPORT_URL=

# ── Live provider checks (opt-in, never in CI) ──────────────────────────────────────────────────────
# `LIVE_INTEGRATION=1 npm run test:live` makes a few real, paid calls (docs/TESTING.md §4). Each reserves
# its worst-case cost first; the run stops at LIVE_BUDGET_USD (default 0.15, hard cap 0.50). Run only with
# the owner's approval. Leave both unset here.
LIVE_INTEGRATION=
LIVE_BUDGET_USD=
